            function section:CreateSlider(sliderOptions)
                sliderOptions = sliderOptions or {}

                local minimum = sliderOptions.Min or sliderOptions.Minimum or 0
                local maximum = sliderOptions.Max or sliderOptions.Maximum or 100
                local decimals = sliderOptions.Decimals or 0
                local suffix = sliderOptions.Suffix or ""
                local flag = sliderOptions.Flag
                local value = clamp(sliderOptions.Default or minimum, minimum, maximum)

                if flag then
                    ARES.Flags[flag] = value
                end

                local base = controlBase(48)

                local sliderLabel = create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(8, 5),
                    Size = UDim2.new(1, -70, 0, 12),
