                    Parent = base
                })
                bindTheme(valueLabel, { TextColor3 = "Text" })

                local sliderHitbox = create("Frame", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(8, 25),
                    Size = UDim2.new(1, -16, 0, 16),
                    Parent = base
                })

                local bar = create("Frame", {
                    BackgroundColor3 = Color3.fromRGB(12, 17, 24),
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Position = UDim2.new(0, 0, 0.5, -2),
                    Size = UDim2.new(1, 0, 0, 4),
                    Parent = sliderHitbox
                }, {
                    corner(4)
                })
                local barStroke = stroke(ARES.Theme.Stroke2, 1, 0.72)
                barStroke.Parent = bar

                local fillGlow = create("Frame", {
                    BackgroundColor3 = ARES.Theme.Accent,
                    BackgroundTransparency = 0.72,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 0.5, -4),
                    Size = UDim2.new(alphaFromRange(value, minimum, maximum), 0, 0, 8),
                    Parent = sliderHitbox
                }, {
                    corner(8)
                })
                bindTheme(fillGlow, { BackgroundColor3 = "Accent" })

                local fill = create("Frame", {
                    BackgroundColor3 = ARES.Theme.Accent,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Size = UDim2.fromScale(alphaFromRange(value, minimum, maximum), 1),
                    Parent = bar
                }, {
                    corner(3)
                })
                bindTheme(fill, { BackgroundColor3 = "Accent" })

                local fillSheen = create("Frame", {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundTransparency = 0.68,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, -26, 0, 0),
                    Size = UDim2.fromOffset(24, 4),
                    Parent = fill
                }, {
                    corner(4),
                    create("UIGradient", {
                        Rotation = 0,
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 1),
                            NumberSequenceKeypoint.new(0.5, 0),
                            NumberSequenceKeypoint.new(1, 1)
                        })
                    })
                })

                local dragging = false
                local api = {}

                local function setFromAlpha(alpha, fireCallback)
                    alpha = clamp(alpha, 0, 1)
                    value = round(minimum + (maximum - minimum) * alpha, decimals)
                    value = clamp(value, minimum, maximum)

                    if flag then
                        ARES.Flags[flag] = value
                    end

                    valueLabel.Text = tostring(value) .. suffix

                    tween(fill, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.fromScale(alpha, 1)
                    })

                    tween(fillGlow, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.new(alpha, 0, 0, dragging and 10 or 8),
                        BackgroundTransparency = dragging and 0.58 or 0.72
                    })

                    fillSheen.Position = UDim2.new(0, -26, 0, 0)
                    tween(fillSheen, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = UDim2.new(1, 4, 0, 0)
                    })

                    if fireCallback and sliderOptions.Callback then
                        task.spawn(sliderOptions.Callback, value)
                    end
                end

                function api:Set(newValue)
                    newValue = clamp(newValue, minimum, maximum)
                    setFromAlpha(alphaFromRange(newValue, minimum, maximum), true)
                end

                function api:Get()
                    return value
                end

                local function update(input)
                    local x = input.Position.X
                    local alpha = (x - sliderHitbox.AbsolutePosition.X) / sliderHitbox.AbsoluteSize.X
                    setFromAlpha(alpha, true)
                end

                sliderHitbox.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        tween(barStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Color = ARES.Theme.Accent,
                            Transparency = 0.48
                        })
                        update(input)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                        tween(fillGlow, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.new(alphaFromRange(value, minimum, maximum), 0, 0, 8),
                            BackgroundTransparency = 0.72
                        })
                        tween(barStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Color = ARES.Theme.Stroke2,
                            Transparency = 0.72
                        })
                    end
                end)

                return api
            end

