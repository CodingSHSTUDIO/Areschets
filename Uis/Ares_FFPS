        local function setActive()
            if window.ActiveTab == tab then
                return
            end

            local previousTab = window.ActiveTab
            window._TabTransitionToken = (window._TabTransitionToken or 0) + 1
            local transitionToken = window._TabTransitionToken

            for _, other in ipairs(window.Tabs) do
                if other ~= previousTab then
                    other.Page.Visible = false
                end
                bindTheme(other.Button, { BackgroundColor3 = "Background3" })
                tween(other.Button, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = ARES.Theme.Background3,
                    Size = UDim2.fromOffset(other.InactiveWidth, 22)
                })

                tween(other.Label, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    TextTransparency = 1
                })

                if other.Icon:IsA("ImageLabel") then
                    bindTheme(other.Icon, { ImageColor3 = "MutedText" })
                    tween(other.Icon, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        ImageColor3 = ARES.Theme.MutedText,
                        Position = UDim2.fromOffset(8, 5)
