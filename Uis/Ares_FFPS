function ARES:Notify(options)
    options = options or {}

    local title = options.Title or "Notification"
    local content = options.Content or options.Text or "Ready"
    local duration = options.Duration or 3
    local icon = options.Icon or "bell"

    if not self.ScreenGui then
        return
    end

    local container = self.NotificationContainer
    if not container then
        container = create("Frame", {
            Name = "Notifications",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -14, 0, 72),
            Size = UDim2.fromOffset(260, 420),
            BackgroundTransparency = 1,
            Parent = self.ScreenGui
        }, {
            listLayout(9, Enum.HorizontalAlignment.Right)
        })

        self.NotificationContainer = container
    end

    local notification = create("Frame", {
        BackgroundColor3 = ARES.Theme.Background2,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(248, 66),
        ClipsDescendants = true,
        Parent = container
    }, {
        corner(8),
        stroke(ARES.Theme.Stroke, 1, 0.18)
    })
    bindTheme(notification, { BackgroundColor3 = "Background2" })

    local scale = create("UIScale", {
        Scale = 0.96,
        Parent = notification
    })

    local iconBubble = create("Frame", {
        BackgroundColor3 = ARES.Theme.Background3,
        Position = UDim2.fromOffset(12, 13),
        Size = UDim2.fromOffset(30, 30),
        Parent = notification
    }, {
        corner(7),
        stroke(ARES.Theme.Stroke, 1, 0.35)
    })
    bindTheme(iconBubble, { BackgroundColor3 = "Background3" })

    createIcon(iconBubble, icon, {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.fromOffset(7, 7),
        ThemeKey = "Accent",
        Fallback = tostring(icon):sub(1, 1):upper(),
        TextSize = 11
    })

    local titleLabel = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(52, 10),
        Size = UDim2.new(1, -64, 0, 16),
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = ARES.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notification
    })
    bindTheme(titleLabel, { TextColor3 = "Text" })
    bindTranslation(titleLabel, "Text", title)

    local contentLabel = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(52, 28),
        Size = UDim2.new(1, -64, 0, 24),
        Text = content,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextWrapped = true,
        TextColor3 = ARES.Theme.MutedText,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = notification
    })
    bindTheme(contentLabel, { TextColor3 = "MutedText" })
    bindTranslation(contentLabel, "Text", content)

    notification.Position = UDim2.fromOffset(24, 0)
    tween(notification, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.02,
        Position = UDim2.fromOffset(0, 0)
    })

    tween(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Scale = 1
    })

    task.delay(duration, function()
        if notification and notification.Parent then
            if not ARES.AnimationsEnabled then
                notification:Destroy()
                return
            end

            tween(notification, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(22, 0)
            })

            tween(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Scale = 0.96
            })

            task.wait(0.17)
            if notification then
                notification:Destroy()
            end
        end
    end)
end

