                            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
                        })
                    })
                })

                local hueDot = create("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    Position = UDim2.fromScale(0, 0.5),
                    Size = UDim2.fromOffset(5, 16),
                    ZIndex = 202,
                    Parent = hueBar
                }, {
                    corner(3)
                })

                local swatch = create("Frame", {
                    BackgroundColor3 = value,
                    Position = UDim2.fromOffset(10, 148),
                    Size = UDim2.fromOffset(26, 22),
                    ZIndex = 201,
                    Parent = popup
                }, {
                    corner(5),
                    stroke(ARES.Theme.Stroke, 1, 0.25)
                })

                local valueBox = create("TextBox", {
                    BackgroundColor3 = ARES.Theme.Background3,
                    Position = UDim2.fromOffset(44, 148),
                    Size = UDim2.fromOffset(85, 22),
                    Font = Enum.Font.GothamBold,
                    TextSize = 9,
                    TextColor3 = ARES.Theme.Text,
                    Text = "",
                    ClearTextOnFocus = false,
                    ZIndex = 201,
                    Parent = popup
                }, {
                    corner(5),
                    stroke(ARES.Theme.Stroke, 1, 0.35)
                })
                bindTheme(valueBox, { BackgroundColor3 = "Background3", TextColor3 = "Text" })

                local close = create("TextButton", {
                    BackgroundColor3 = ARES.Theme.Background3,
                    Position = UDim2.fromOffset(137, 148),
                    Size = UDim2.fromOffset(37, 22),
                    Text = "OK",
                    Font = Enum.Font.GothamBold,
                    TextSize = 9,
                    TextColor3 = ARES.Theme.Accent,
                    AutoButtonColor = false,
                    ZIndex = 201,
                    Parent = popup
                }, {
                    corner(5)
                })
                bindTheme(close, { BackgroundColor3 = "Background3", TextColor3 = "Accent" })

                local hue, sat, val = value:ToHSV()
                local draggingSv = false
                local draggingHue = false
                local isOpen = false
                local api = {}

                local function colorToHex(color)
                    return string.format(
                        "#%02x%02x%02x",
                        math.floor(color.R * 255 + 0.5),
                        math.floor(color.G * 255 + 0.5),
                        math.floor(color.B * 255 + 0.5)
                    )
                end

                local function setColor(color, fireCallback)
                    value = color
                    hue, sat, val = value:ToHSV()

                    preview.BackgroundColor3 = value
                    swatch.BackgroundColor3 = value
                    saturationValue.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                    pickerDot.Position = UDim2.fromScale(sat, 1 - val)
                    hueDot.Position = UDim2.fromScale(hue, 0.5)
                    valueBox.Text = colorToHex(value)

                    if flag then
                        ARES.Flags[flag] = value
                    end

                    if fireCallback and colorPickerOptions.Callback then
                        task.spawn(colorPickerOptions.Callback, value)
                    end
                end

                local function setFromSv(input)
                    local x = clamp((input.Position.X - saturationValue.AbsolutePosition.X) / saturationValue.AbsoluteSize.X, 0, 1)
                    local y = clamp((input.Position.Y - saturationValue.AbsolutePosition.Y) / saturationValue.AbsoluteSize.Y, 0, 1)
                    sat = x
                    val = 1 - y
                    setColor(Color3.fromHSV(hue, sat, val), true)
                end

                local function setFromHue(input)
                    hue = clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                    setColor(Color3.fromHSV(hue, sat, val), true)
                end

                local function pointInside(frame, x, y)
                    local pos = frame.AbsolutePosition
                    local size = frame.AbsoluteSize
                    return x >= pos.X and x <= pos.X + size.X and y >= pos.Y and y <= pos.Y + size.Y
                end

                function api:Set(color)
                    setColor(color, true)
                end

                function api:Get()
                    return value
                end

                function api:Close()
                    if not isOpen then
                        return
                    end

                    isOpen = false

                    if not ARES.AnimationsEnabled then
                        popup.Visible = false
                        popup.BackgroundTransparency = 0
                        shadow.Visible = false
                        shadow.BackgroundTransparency = 0.55
                        popupScale.Scale = 1
                        return
                    end

                    tween(popupScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Scale = 0.96
                    })
                    tween(popup, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        BackgroundTransparency = 1
                    })
                    tween(shadow, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        BackgroundTransparency = 1
                    })

                    task.delay(0.12, function()
                        if not isOpen then
                            if popup and popup.Parent then
                                popup.Visible = false
                                popup.BackgroundTransparency = 0
                            end
                            if shadow and shadow.Parent then
                                shadow.Visible = false
                                shadow.BackgroundTransparency = 0.55
                            end
                        end
                    end)
                end

                local function openPopup()
                    for _, picker in ipairs(ARES.OpenColorPickers) do
                        if picker ~= api and picker.Close then
                            picker:Close()
                        end
                    end

                    local screenSize = ARES.ScreenGui.AbsoluteSize
                    local absolute = preview.AbsolutePosition
                    local buttonSize = preview.AbsoluteSize
                    local margin = 8

                    local targetX = absolute.X + buttonSize.X - popupWidth
                    local targetY = absolute.Y + buttonSize.Y + 8

                    if targetY + popupHeight > screenSize.Y - margin then
                        targetY = absolute.Y - popupHeight - 8
                    end

                    targetY = clamp(targetY, margin, math.max(margin, screenSize.Y - popupHeight - margin))
                    targetX = clamp(targetX, margin, math.max(margin, screenSize.X - popupWidth - margin))

                    popup.Position = UDim2.fromOffset(targetX, targetY)
                    shadow.Position = UDim2.fromOffset(targetX + 3, targetY + 4)

                    isOpen = true
                    popup.BackgroundTransparency = 1
                    shadow.BackgroundTransparency = 1
                    popupScale.Scale = 0.96
                    popup.Visible = true
                    shadow.Visible = true

                    tween(popupScale, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        Scale = 1
                    })
                    tween(popup, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0
                    })
                    tween(shadow, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0.55
                    })
                end

                preview.MouseButton1Click:Connect(function()
                    if isOpen then
                        api:Close()
                    else
                        openPopup()
                    end
                end)

                close.MouseButton1Click:Connect(function()
                    api:Close()
                end)

                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if not isOpen then
                        return
                    end

                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end

                    local position = input.Position
                    if pointInside(popup, position.X, position.Y) or pointInside(preview, position.X, position.Y) then
                        return
                    end

                    api:Close()
                end)

                saturationValue.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSv = true
                        tween(pickerDot, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(10, 10)
                        })
                        setFromSv(input)
                    end
                end)

                hueBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingHue = true
                        tween(hueDot, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(5, 17)
                        })
                        setFromHue(input)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                        if draggingSv then
                            setFromSv(input)
                        elseif draggingHue then
                            setFromHue(input)
                        end
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSv = false
                        draggingHue = false
                        tween(pickerDot, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(8, 8)
                        })
                        tween(hueDot, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(5, 16)
                        })
                    end
                end)

                valueBox.FocusLost:Connect(function()
                    local hex = valueBox.Text:gsub("#", "")
                    if #hex == 6 then
                        local r = tonumber(hex:sub(1, 2), 16)
                        local g = tonumber(hex:sub(3, 4), 16)
                        local b = tonumber(hex:sub(5, 6), 16)

                        if r and g and b then
                            setColor(Color3.fromRGB(r, g, b), true)
                        end
                    else
                        valueBox.Text = colorToHex(value)
                    end
                end)

                table.insert(ARES.OpenColorPickers, api)
                setColor(value, false)

                return api
            end

            table.insert(tab.Sections, section)
            section.Instance = holder
            return section
        end

        table.insert(window.Tabs, tab)

        if not window.ActiveTab then
            setActive()
        end

        return tab
    end

    if options.StatusBar ~= false then
        self:CreateStatusBar({
            Text = options.WatermarkText or options.Title or title,
            Icon = options.WatermarkIcon or options.Icon or "gem"
        })
    elseif options.Watermark ~= false then
        self:CreateWatermark({
            Text = options.WatermarkText or "This is a watermark",
            Icon = options.WatermarkIcon or options.Icon or "gem"
        })

        if options.Stats ~= false then
            self:CreateStatsPills()
        end
    end

    main.Visible = true
    main.GroupTransparency = 0
    main.Position = position
    mainScale.Scale = 1
    return window
end

function ARES:GetThemes()
    local names = {}

    for name in pairs(ARES.Themes) do
        table.insert(names, name)
    end

    table.sort(names)
    return names
end

function ARES:SetTheme(theme)
    local source = theme

    if typeof(theme) == "string" then
        source = ARES.Themes[theme]
    end

    if type(source) ~= "table" then
        return false
    end

    for key, value in pairs(source) do
        if ARES.Theme[key] ~= nil then
            ARES.Theme[key] = value
        end
    end

    applyThemeToRegistered()
    return true
end

function ARES:GetLanguages()
    local languages = {}

    for language in pairs(ARES.LanguageTargets) do
        table.insert(languages, language)
    end

    table.sort(languages)
    return languages
end

function ARES:SetLanguage(language)
    return setLanguage(language)
end

function ARES:GetLanguage()
    return ARES.Language
end

function ARES:GetLanguageName(language)
    return getLanguageName(language or ARES.Language)
end

function ARES:Translate(text, language)
    return translateText(text, language)
end

function ARES:BindTranslation(instance, property, sourceText, formatter)
    return bindTranslation(instance, property or "Text", sourceText, formatter)
end

function ARES:SetAutoTranslate(state)
    ARES.AutoTranslate = state ~= false
    applyTranslations()
end

function ARES:ClearTranslationCache(language)
    if language then
        local target = ARES.LanguageTargets[normalizeLanguage(language)]
        if target then
            ARES._TranslationCache[target] = {}
        end
    else
        ARES._TranslationCache = {}
    end

    applyTranslations()
end

function ARES:SetLanguageTarget(language, targetCode)
    language = normalizeLanguage(language)
    ARES.LanguageTargets[language] = tostring(targetCode or "")
    ARES._TranslationCache[ARES.LanguageTargets[language]] = ARES._TranslationCache[ARES.LanguageTargets[language]] or {}
end

function ARES:SetIconPack(iconPack)
    ARES.IconPack = iconPack or "lucide"
end

function ARES:SetIconRaw(url)
    ARES.IconRaw = url or ARES.IconRaw
    ARES.IconModule = nil
end

function ARES:ResolveIcon(icon, iconType)
    return resolveIcon(icon, iconType)
end

function ARES:CreateIcon(parent, icon, options)
    return createIcon(parent, icon, options)
end

function ARES:GetFlag(flag)
    return ARES.Flags[flag]
end

function ARES:SetFlag(flag, value)
    ARES.Flags[flag] = value
end

function ARES:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

