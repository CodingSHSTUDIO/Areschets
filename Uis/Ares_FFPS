    local function applyLanguageChange(language, callback)
        language = normalizeLanguage(language)

        if changingLanguage then
            return
        end

        if language == ARES.Language then
            refreshLanguageButtons(language)
            return
        end

        languageLoadingToken += 1
        local token = languageLoadingToken
        changingLanguage = true
        local finished = false

        if languageSummary then
            languageSummary.Text = getLanguageName(language) .. " / " .. language
        end

        if languageLoadingRow then
            languageLoadingRow.Visible = true
            languageLoadingRow.BackgroundTransparency = 0.12
            tween(languageLoadingRow, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.06
            })
        end

        if languageLoadingText then
            languageLoadingText.Text = getLanguagePhrase("ApplyingLanguage", language) .. "..."
            languageLoadingText.TextTransparency = 0
        end

        if languageLoadingSpinner then
            languageLoadingSpinner.Visible = true
            languageLoadingSpinner.Rotation = 0
            task.spawn(function()
                while token == languageLoadingToken and changingLanguage and languageLoadingSpinner and languageLoadingSpinner.Parent do
                    local spinnerTween = TweenService:Create(languageLoadingSpinner, TweenInfo.new(0.42, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
                        Rotation = languageLoadingSpinner.Rotation + 180
                    })
                    spinnerTween:Play()
                    task.wait(0.42)
                end
            end)
        end

        local function finishLoading(success)
            if finished or token ~= languageLoadingToken then
                return
            end

            finished = true
            changingLanguage = false

            if languageLoadingText then
                languageLoadingText.Text = getLanguagePhrase(success and "LanguageApplied" or "LanguagePartiallyApplied", ARES.Language)
            end

            task.delay(0.38, function()
                if token ~= languageLoadingToken then
                    return
                end

                if languageLoadingRow and languageLoadingRow.Parent then
                    tween(languageLoadingRow, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 1
                    })
                end

                if languageLoadingText then
                    tween(languageLoadingText, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        TextTransparency = 1
                    })
                end

                task.delay(0.17, function()
                    if token == languageLoadingToken and languageLoadingRow and languageLoadingRow.Parent then
                        languageLoadingRow.Visible = false
                        languageLoadingRow.BackgroundTransparency = 0.12
                        if languageLoadingSpinner then
                            languageLoadingSpinner.Visible = false
                            languageLoadingSpinner.Rotation = 0
                        end
                    end
                end)
            end)
        end

        task.delay(3.2, function()
            finishLoading(false)
        end)

        task.spawn(function()
            local ok, nextLanguage = pcall(setLanguage, language)

            if ok and callback then
                task.spawn(callback, nextLanguage)
            end

            finishLoading(ok)
        end)
    end

