                    arrow.Text = open and "^" or "v"
                    if open then
                        dropdownFrame.CanvasPosition = Vector2.new(0, 0)
                    end

                    tween(selectStroke, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Color = open and ARES.Theme.Accent or ARES.Theme.Stroke,
                        Transparency = open and 0.45 or 0.35
                    })

                    local targetHeight = open and math.min(#values * 25 + 8, 120) or 0
                    local targetBaseHeight = open and (58 + targetHeight) or 54

                    tween(base, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        Size = UDim2.new(1, 0, 0, targetBaseHeight)
                    })

                    tween(dropdownScale, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        Scale = open and 1 or 0.98
                    })

                    tween(dropdownFrame, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundTransparency = open and 0 or 1
                    })

                    tween(dropdownStroke, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Transparency = open and 0.35 or 1
                    })

                    tween(dropdownFrame, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        Size = UDim2.new(1, -16, 0, targetHeight)
                    })

                    if not open then
                        task.delay(0.16, function()
                            if dropdownFrame and dropdownFrame.Parent and not open then
                                dropdownFrame.Visible = false
                            end
                        end)
                    end
                end

                local function refresh()
                    optionButtons = {}

                    for _, child in ipairs(dropdownFrame:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end

                    for _, option in ipairs(values) do
                        local isSelected = option == selected
                        local optionButton = create("TextButton", {
                            BackgroundColor3 = isSelected and ARES.Theme.Accent or ARES.Theme.Background3,
                            BackgroundTransparency = isSelected and 0.82 or 0.35,
                            Size = UDim2.new(1, 0, 0, 21),
                            Text = "",
                            Font = Enum.Font.Gotham,
                            TextSize = 9,
                            TextColor3 = ARES.Theme.MutedText,
                            AutoButtonColor = false,
                            Parent = dropdownFrame
                        }, {
                            corner(4)
                        })
                        bindTheme(optionButton, { BackgroundColor3 = isSelected and "Accent" or "Background3" })

                        local optionAccent = create("Frame", {
                            BackgroundColor3 = ARES.Theme.Accent,
                            BackgroundTransparency = isSelected and 0 or 1,
                            BorderSizePixel = 0,
                            Position = UDim2.fromOffset(5, 6),
                            Size = UDim2.fromOffset(2, 9),
                            Parent = optionButton
                        }, {
                            corner(2)
                        })
                        bindTheme(optionAccent, { BackgroundColor3 = "Accent" })

                        local optionLabel = create("TextLabel", {
                            BackgroundTransparency = 1,
                            Position = UDim2.fromOffset(12, 0),
                            Size = UDim2.new(1, -20, 1, 0),
                            Text = tostring(option),
                            Font = Enum.Font.GothamSemibold,
                            TextSize = 9,
                            TextColor3 = isSelected and ARES.Theme.Text or ARES.Theme.MutedText,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Parent = optionButton
                        })
                        bindTheme(optionLabel, { TextColor3 = isSelected and "Text" or "MutedText" })
                        bindTranslation(optionLabel, "Text", tostring(option))

                        table.insert(optionButtons, {
                            Button = optionButton,
                            Label = optionLabel,
                            Accent = optionAccent,
                            Value = option
                        })

                        optionButton.MouseEnter:Connect(function()
                            local stillSelected = selected == option
                            tween(optionButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                BackgroundTransparency = stillSelected and 0.75 or 0.18
                            })

                            tween(optionAccent, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                BackgroundTransparency = 0.1
                            })
                        end)

                        optionButton.MouseLeave:Connect(function()
                            local stillSelected = selected == option
                            tween(optionButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                BackgroundTransparency = stillSelected and 0.82 or 0.35
                            })

                            tween(optionAccent, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                BackgroundTransparency = stillSelected and 0 or 1
                            })
                        end)

                        optionButton.MouseButton1Click:Connect(function()
                            api:Set(option)
                            setOpen(false)
                        end)
                    end
                end

                function api:Set(valueToSet)
                    selected = valueToSet
                    bindTranslation(selectedLabel, "Text", tostring(selected))

                    for _, item in ipairs(optionButtons) do
                        local isSelected = item.Value == selected
                        bindTheme(item.Button, { BackgroundColor3 = isSelected and "Accent" or "Background3" })
                        bindTheme(item.Label, { TextColor3 = isSelected and "Text" or "MutedText" })

                        tween(item.Button, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundColor3 = isSelected and ARES.Theme.Accent or ARES.Theme.Background3,
                            BackgroundTransparency = isSelected and 0.82 or 0.35
                        })

                        tween(item.Accent, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundTransparency = isSelected and 0 or 1
                        })

                        tween(item.Label, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            TextColor3 = isSelected and ARES.Theme.Text or ARES.Theme.MutedText
                        })
                    end

                    if flag then
                        ARES.Flags[flag] = selected
                    end

                    if dropdownOptions.Callback then
                        task.spawn(dropdownOptions.Callback, selected)
                    end
                end

                function api:Get()
                    return selected
                end

                function api:Refresh(newValues, keepSelected)
                    values = newValues or {}
                    if not keepSelected then
                        selected = values[1] or "None"
                        bindTranslation(selectedLabel, "Text", tostring(selected))
                    end

                    refresh()
                end

                selectButton.MouseButton1Click:Connect(function()
                    setOpen(not open)
                end)

                selectButton.MouseEnter:Connect(function()
                    tween(selectStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Color = ARES.Theme.Accent,
                        Transparency = 0.55
                    })
                end)

                selectButton.MouseLeave:Connect(function()
                    if not open then
                        tween(selectStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Color = ARES.Theme.Stroke,
                            Transparency = 0.35
                        })
                    end
                end)

                refresh()

                return api
            end

