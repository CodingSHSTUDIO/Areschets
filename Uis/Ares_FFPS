local function getThemeValue(key)
    return ARES.Theme[key] or key
end

local function bindTheme(instance, bindings)
    for _, item in ipairs(ARES._ThemeObjects) do
        if item.Instance == instance then
            for property, key in pairs(bindings) do
                item.Bindings[property] = key
                instance[property] = getThemeValue(key)
            end

            return instance
        end
    end

    table.insert(ARES._ThemeObjects, {
        Instance = instance,
        Bindings = bindings
    })

    for property, key in pairs(bindings) do
        instance[property] = getThemeValue(key)
    end

    return instance
end

local function applyThemeToRegistered()
    for index = #ARES._ThemeObjects, 1, -1 do
        local item = ARES._ThemeObjects[index]

        if not item.Instance or not item.Instance.Parent then
            table.remove(ARES._ThemeObjects, index)
        else
            for property, key in pairs(item.Bindings) do
                item.Instance[property] = getThemeValue(key)
            end
        end
    end
end

local function normalizeLanguage(language)
    language = tostring(language or ARES.Language or "ENG"):upper()

    if language == "ES" or language == "ESPANOL" or language == "SPANISH" then
        return "SPA"
    end

    if language == "RU" or language == "RUSSIAN" then
        return "RUS"
    end

    if language == "EN" or language == "ENGLISH" then
        return "ENG"
    end

    if language == "TAGALOG" or language == "FILIPINO" or language == "FIL" then
        return "PHIL"
    end

    if language == "PT" or language == "PORTUGUESE" then
        return "POR"
    end

    if language == "FR" or language == "FRENCH" then
        return "FRA"
    end

    if language == "DE" or language == "GERMAN" then
        return "GER"
    end

    if language == "JP" or language == "JA" or language == "JAPANESE" then
        return "JPN"
    end

    if language == "KR" or language == "KO" or language == "KOREAN" then
        return "KOR"
    end

    if language == "CN" or language == "ZH" or language == "CHINESE" then
        return "CHN"
    end

    return language
end

local function getLanguageName(language)
    language = normalizeLanguage(language)
    return ARES.LanguageNames[language] or language
end

local function getLanguagePhrase(key, language)
    language = normalizeLanguage(language or ARES.Language)
    local phrases = ARES.LanguagePhrases[language] or ARES.LanguagePhrases.ENG
    return phrases[key] or ARES.LanguagePhrases.ENG[key] or tostring(key)
end

local function shouldTranslate(text)
    local source = tostring(text or "")

    if source == "" then
        return false
    end

    if source:find("^%s*$") then
        return false
    end

    if source:match("^%s*[%u%d_%-]+%s*$") and #source <= 8 then
        return false
    end

    if source:match("^%s*#?[%x]+%s*$") then
        return false
    end

    if source:find("ARES") or source:find("rbxassetid://") then
        return false
    end

    return true
end

local function readTranslatedText(response)
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not ok or type(decoded) ~= "table" or type(decoded[1]) ~= "table" then
        return nil
    end

    local parts = {}

    for _, segment in ipairs(decoded[1]) do
        if type(segment) == "table" and type(segment[1]) == "string" then
            table.insert(parts, segment[1])
        end
    end

    if #parts == 0 then
        return nil
    end

    return table.concat(parts)
end

local function requestAutoTranslation(text, language)
    local target = ARES.LanguageTargets[normalizeLanguage(language)]
    local source = tostring(text or "")

    if not ARES.AutoTranslate or not target or target == "en" or not shouldTranslate(source) then
        return source
    end

    ARES._TranslationCache[target] = ARES._TranslationCache[target] or {}

    if ARES._TranslationCache[target][source] then
        return ARES._TranslationCache[target][source]
    end

    local url = ARES.TranslationEndpoint
        .. "?client=gtx&sl=auto&tl="
        .. HttpService:UrlEncode(target)
        .. "&dt=t&q="
        .. HttpService:UrlEncode(source)

    local ok, response = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok or type(response) ~= "string" or response == "" then
        ARES._TranslationCache[target][source] = source
        return source
    end

    local translated = readTranslatedText(response) or source
    ARES._TranslationCache[target][source] = translated
    return translated
end

local function translateText(text, language)
    local source = tostring(text or "")
    language = normalizeLanguage(language)

    if language == "ENG" then
        return source
    end

    return requestAutoTranslation(source, language)
end

local function bindTranslation(instance, property, sourceText, formatter)
    if not instance or not property then
        return instance
    end

    for _, item in ipairs(ARES._TextObjects) do
        if item.Instance == instance and item.Property == property then
            item.Source = tostring(sourceText or "")
            item.Formatter = formatter
            instance[property] = formatter and formatter(translateText(item.Source)) or translateText(item.Source)
            return instance
        end
    end

    table.insert(ARES._TextObjects, {
        Instance = instance,
        Property = property,
        Source = tostring(sourceText or ""),
        Formatter = formatter
    })

    instance[property] = formatter and formatter(translateText(sourceText)) or translateText(sourceText)
    return instance
end

local function applyTranslations()
    for index = #ARES._TextObjects, 1, -1 do
        local item = ARES._TextObjects[index]

        if not item.Instance or not item.Instance.Parent then
            table.remove(ARES._TextObjects, index)
        else
            local translated = translateText(item.Source)
            item.Instance[item.Property] = item.Formatter and item.Formatter(translated) or translated
        end
    end
end

local function setLanguage(language)
    ARES.Language = normalizeLanguage(language)
    ARES.Flags.__Language = ARES.Language
    applyTranslations()

    for index = #ARES._LanguageListeners, 1, -1 do
        local callback = ARES._LanguageListeners[index]

        if type(callback) ~= "function" then
            table.remove(ARES._LanguageListeners, index)
        else
            task.spawn(callback, ARES.Language)
        end
    end

    return ARES.Language
end

local function getRemote(url)
    local okHttpGet, result = pcall(function()
        return game:HttpGet(url)
    end)

    if okHttpGet and result then
        return result
    end

    local okService, serviceResult = pcall(function()
        return HttpService:GetAsync(url)
    end)

    if okService then
        return serviceResult
    end

    return nil
end

local function getIconModule()
    if ARES.IconModule ~= nil then
        return ARES.IconModule
    end

    local source = getRemote(ARES.IconRaw)
    if not source or source == "" then
        ARES.IconModule = false
        return nil
    end

    local ok, module = pcall(function()
        return loadstring(source)()
    end)

    if ok and type(module) == "table" then
        ARES.IconModule = module
        return module
    end

    ARES.IconModule = false
    return nil
end

local function resolveIcon(icon, iconType)
    if typeof(icon) == "number" then
        return {
            Image = "rbxassetid://" .. tostring(icon),
            ImageRectSize = Vector2.new(0, 0),
            ImageRectOffset = Vector2.new(0, 0)
        }
    end

    if typeof(icon) ~= "string" or icon == "" then
        return nil
    end

    if icon:match("^%d+$") then
        return {
            Image = "rbxassetid://" .. icon,
            ImageRectSize = Vector2.new(0, 0),
            ImageRectOffset = Vector2.new(0, 0)
        }
    end

    if icon:find("^rbxasset") then
        return {
            Image = icon,
            ImageRectSize = Vector2.new(0, 0),
            ImageRectOffset = Vector2.new(0, 0)
        }
    end

    local iconModule = getIconModule()
    if not iconModule or not iconModule.Icon2 then
        return nil
    end

    local ok, result = pcall(function()
        return iconModule.Icon2(icon, iconType or ARES.IconPack)
    end)

    if not ok or not result then
        return nil
    end

    if typeof(result) == "string" then
        return {
            Image = result,
            ImageRectSize = Vector2.new(0, 0),
            ImageRectOffset = Vector2.new(0, 0)
        }
    end

    return {
        Image = result[1],
        ImageRectSize = result[2] and result[2].ImageRectSize or Vector2.new(0, 0),
        ImageRectOffset = result[2] and result[2].ImageRectPosition or Vector2.new(0, 0)
    }
end

local function createIcon(parent, icon, options)
    options = options or {}

    local iconData = resolveIcon(icon, options.Type)
    local size = options.Size or UDim2.fromOffset(18, 18)
    local position = options.Position or UDim2.fromOffset(0, 0)
    local color = options.Color or ARES.Theme.Accent

    if iconData then
        local image = create("ImageLabel", {
            BackgroundTransparency = 1,
            Size = size,
            Position = position,
            Image = iconData.Image,
            ImageRectSize = iconData.ImageRectSize,
            ImageRectOffset = iconData.ImageRectOffset,
            ImageColor3 = color,
            ScaleType = Enum.ScaleType.Fit,
            Parent = parent
        })

        if options.ThemeKey then
            bindTheme(image, { ImageColor3 = options.ThemeKey })
        end

        return image
    end

    local fallback = options.Fallback or tostring(icon or "*"):sub(1, 1):upper()
    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Position = position,
        Text = fallback,
        Font = Enum.Font.GothamBlack,
        TextSize = options.TextSize or 13,
        TextColor3 = color,
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = parent
    })

    if options.ThemeKey then
        bindTheme(label, { TextColor3 = options.ThemeKey })
    end

    return label
end

local function safeParent(screenGui)
    local parent

    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then
            parent = hui
        end
    end

    if not parent then
        local okCore = pcall(function()
            screenGui.Parent = CoreGui
        end)

        if okCore then
            return
        end
    end

    if parent then
        screenGui.Parent = parent
        return
    end

    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    screenGui.Parent = playerGui or CoreGui
end

local function makeDraggable(handle, target)
    local dragging = false
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = target.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

local function bindHover(button, normalColor, hoverColor)
    button.MouseEnter:Connect(function()
        tween(button, TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverColor
        })
    end)

    button.MouseLeave:Connect(function()
        tween(button, TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = normalColor
        })
    end)
end

