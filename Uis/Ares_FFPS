            page.Visible = true
            page.GroupTransparency = 1
            page.Position = UDim2.fromOffset(0, 0)
            pageScale.Scale = 1
            tween(page, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
