                    tween(other.Icon, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        TextColor3 = ARES.Theme.MutedText,
                        Position = UDim2.fromOffset(8, 5)
                    })
                end
            end


            if previousTab and previousTab.Page.Visible then
                tween(previousTab.Page, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    GroupTransparency = 1
                })
                task.delay(0.09, function()
